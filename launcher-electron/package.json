{
  "name": "claudium-launcher",
  "productName": "Claudium",
  "version": "0.1.0",
  "description": "The Claudium launcher: sign in with Microsoft and play Claudium (Minecraft: Java Edition, in Rust).",
  "license": "MIT",
  "author": "Claudium",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "dev.claudium.launcher",
    "productName": "Claudium",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "auth.js", "game.js", "preload.js", "renderer/**/*", "package.json"],
    "extraResources": [
      { "from": "bin", "to": "bin", "filter": ["**/*"] },
      { "from": "game", "to": "game", "filter": ["**/*"] },
      { "from": "runtime", "to": "runtime", "filter": ["**/*"] }
    ],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "build/icon.ico",
      "executableName": "Claudium-Launcher"
    },
    "nsis": {
      "artifactName": "Claudium-Launcher-Setup.exe",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
